{
  "name": "idleit",
  "productName": "Farmling",
  "version": "0.14.0",
  "description": "Idle game de ferme miniature qui vit au-dessus de la barre des tâches.",
  "main": "src/main.js",
  "author": "TisaTHor08",
  "license": "MIT",
  "scripts": {
    "start": "node tools/start.js",
    "debug": "node tools/start.js --farm-debug",
    "sim": "node tools/sim.js",
    "icon": "node tools/make-icon.js",
    "save-editor": "node tools/make-save-editor.js",
    "wiki": "node tools/make-save-editor.js && node tools/wiki/build.js",
    "wiki:sprites": "electron tools/wiki/export-sprites.js",
    "wiki:serve": "node tools/wiki/serve.js",
    "release": "node tools/release.js",
    "build": "electron-builder --win portable nsis"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.idleit.ferme",
    "productName": "Farmling",
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Farmling-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Farmling-portable-${version}.exe"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "TisaTHor08",
        "repo": "IdleIt"
      }
    ]
  },
  "allowScripts": {
    "electron@33.4.11": true
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
